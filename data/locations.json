  "scenes": {
    "sokaya": {
      "npcId": "naho",
      "npcRole": "店家的孙女",
      "curtain": "咸甜味",
      "clueId": "senbei-jacket",
      "background": "assets/locations/senbei-shop.png",
      "dialogue": [
        ["kaga", "关于田仓先生的着装，我想再确认一下。"],
        ["naho", "他那天穿着灰色正装；上次来时，是褐色的。"],
        ["kaga", "颜色先放在一边。当时，他穿着西装上衣吗？"],
        ["naho", "穿着。这有什么关系吗？"],
        ["kaga", "还不清楚。谢谢你。"]
      ],
      "visualKey": "sokaya"
    },
    "kiku": {
      "npcId": "yoriko",
      "npcRole": "料亭老板娘",
      "curtain": "松矢料亭",
      "clueId": "ningyoyaki-route",
      "background": "assets/locations/ryotei.png",
      "dialogue": [
        ["kaga", "询问人形烧的来处"],
        [
          "yoriko",
          "人形烧并非直接送给峰子。它经过邻居的手，才出现在她的房间里。礼物的去向，比包装更值得追问。"
        ],
        ["kaga", "追问芥末是给谁的"],
        [
          "yoriko",
          "赖子承认那是给丈夫的一个教训。她并不认识峰子，也没有料到点心会被转送。一场夫妻间的别扭，偶然走进了案件。"
        ]
      ],
      "visualKey": "kiku"
    },
    "ubukeya": {
      "npcId": "maki",
      "npcRole": "陶瓷器店的媳妇",
      "curtain": "刃物",
      "clueId": "kitchen-scissors",
      "background": "assets/locations/ceramics-shop.png",
      "dialogue": [
        ["kaga", "看看柜台上的剪刀订单"],
        [
          "maki",
          "峰子受托买的厨剪，并不是这份订单要找的东西。订单上圈着一把小巧的食用剪。"
        ],
        ["kaga", "问问这份礼物"],
        [
          "maki",
          "麻纪准备把食用剪送给即将旅行的婆婆，让她能吃喜欢的食物。峰子只是帮忙买错了东西。"
        ]
      ],
      "visualKey": "yanagisawa",
      "chapterVariants": {
        "6": {
          "npcId": "maki",
          "npcRole": "柳泽家 儿媳",
          "clueId": "sakura-chopsticks",
          "dialogue": [
            ["kaga", "三井峰子曾在这里订过一双樱花图案的夫妇筷吗？"],
            ["maki", "是的。那是她为朋友结婚准备的礼物。"]
          ]
        }
      }
    },
    "tamahide": {
      "npcId": "hiroki",
      "npcRole": "峰子的儿子",
      "curtain": "玉秀",
      "clueId": "mineko-reason",
      "dialogue": [
        ["kaga", "谈谈母亲搬来的原因"],
        [
          "hiroki",
          "你和弘毅拼出母亲的误会：她以为儿子即将成为父亲，因此想在附近生活，也想替他准备一些钱。"
        ]
      ],
      "visualKey": "tamahide",
      "background": "assets/locations/street.png"
    },
    "kaiseiken": {
      "npcId": "hiroki",
      "npcRole": "峰子的儿子",
      "curtain": "咖啡",
      "clueId": "account-review",
      "dialogue": [
        ["kaga", "调查峰子最近的查账要求"],
        [
          "hiroki",
          "峰子曾要求岸田重新核对账户。对她来说，这是为儿子争取帮助；对经手账户的人来说，却可能意味着秘密将被揭开。"
        ]
      ],
      "visualKey": "kaiseiken",
      "background": "assets/locations/street.png"
    },
    "craft": {
      "npcId": "craft-owner",
      "npcRole": "留意顾客双手的店主",
      "curtain": "童梦屋",
      "clueId": "spinning-top-string",
      "background": "assets/locations/folk-art-shop.png",
      "dialogue": [
        ["kaga", "比较两家店的陀螺线"],
        [
          "craft-owner",
          "你把玩具店的同款样品与民艺店的商品作比较：一边是捻绳，另一边是组绳。不能把所有“绳子”当作同一种东西。"
        ]
      ],
      "visualKey": "craft"
    },
    "benkei": {
      "npcId": "genichi",
      "npcRole": "钟表店老板",
      "curtain": "弁庆",
      "clueId": "walking-route",
      "dialogue": [
        ["kaga", "沿散步路线走一段"],
        [
          "genichi",
          "狗在通往水天宫的路口迟疑。你再看峰子的记录，她摸过的“小狗”可能是子宝犬铜像。路线有了另一种解释。"
        ]
      ],
      "visualKey": "terada",
      "background": "assets/locations/watch-shop.png"
    },
    "shigemori": {
      "npcId": "shuhei",
      "npcRole": "料亭的小伙计",
      "curtain": "人形烧",
      "clueId": "ningyoyaki-route",
      "background": "assets/locations/street.png",
      "dialogue": [
        ["kaga", "询问人形烧的来处"],
        [
          "shuhei",
          "人形烧并非直接送给峰子。它经过邻居的手，才出现在她的房间里。礼物的去向，比包装更值得追问。"
        ]
      ],
      "visualKey": "kiku"
    },
    "suitengu": {
      "npcId": "genichi",
      "npcRole": "钟表店老板",
      "curtain": "水天宫",
      "clueId": "walking-route",
      "background": "assets/locations/suitengu.png",
      "dialogue": [
        ["kaga", "谈谈离家的女儿"],
        [
          "genichi",
          "玄一说女儿的生活与自己无关。他还否认曾为了什么事特地去水天宫。语气太坚决，反而像在挡住某个话题。"
        ],
        ["kaga", "沿散步路线走一段"],
        [
          "genichi",
          "狗在通往水天宫的路口迟疑。你再看峰子的记录，她摸过的“小狗”可能是子宝犬铜像。路线有了另一种解释。"
        ]
      ],
      "visualKey": "suitengu"
    },
    "quattro": {
      "npcId": "miyuki",
      "npcRole": "西饼店 店员",
      "curtain": "西饼店",
      "clueId": "pregnant-misunderstanding",
      "background": "assets/locations/pastry-shop.png",
      "dialogue": [
        ["kaga", "三井峰子经常来这里吗？"],
        ["miyuki", "她常在傍晚来到店里，坐在咖啡厅看着我。我们并不认识。"]
      ],
      "visualKey": "quattro"
    },
    "cleaning-company": {
      "npcId": "naohiro",
      "npcRole": "保洁公司 社长",
      "curtain": "清濑保洁公司",
      "clueId": "naohiro-finances",
      "background": "assets/locations/cleaning-company.png",
      "dialogue": [
        ["kaga", "三井峰子为什么重新询问财产问题？"],
        ["naohiro", "她在离婚后重新要求核对旧账。公司的账目一直由岸田处理。"]
      ],
      "visualKey": "cleaning-company"
    }
  },
